# Normalise line endings; shell scripts must stay LF or they break on Linux/Docker.
* text=auto eol=lf
*.sh text eol=lf
*.command text eol=lf
# Binary assets
*.woff2 binary
*.png binary
*.jpg binary
*.ico binary
